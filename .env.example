# The_BORG_DB (ctxmtg) — environment configuration example
# Copy this file to ~/.ctxmtg/.env and fill in real values.
# Each instance (e.g. Local_Tickets, Local_Emails, Hive) needs its own copy
# under its own CTXMTG_HOME directory.

# -----------------------------------------------------------------------------
# Instance identity — used for hive outbox manifests and sync routing.
# -----------------------------------------------------------------------------
CTXMTG_HIVE__INSTANCE_NAME=Local_Example

# -----------------------------------------------------------------------------
# LLM Role Configuration
# Format matches the web UI "Save All to .env" output.
# Point BASE_URL at any OpenAI-compatible endpoint (LM Studio, Ollama,
# OpenAI, Anthropic via proxy, etc.). API_KEY can be a dummy string for
# local servers that don't require auth.
# -----------------------------------------------------------------------------

# --- Lighter roles (recommended: small/medium local model) -------------------

CTXMTG_LLM__EXTRACTION__API_KEY=sk-dummy-key
CTXMTG_LLM__EXTRACTION__BASE_URL=http://localhost:1234/v1
CTXMTG_LLM__EXTRACTION__MODEL=your-light-model-id

CTXMTG_LLM__QUERY_PLANNING__API_KEY=sk-dummy-key
CTXMTG_LLM__QUERY_PLANNING__BASE_URL=http://localhost:1234/v1
CTXMTG_LLM__QUERY_PLANNING__MODEL=your-light-model-id

CTXMTG_LLM__FARMING__API_KEY=sk-dummy-key
CTXMTG_LLM__FARMING__BASE_URL=http://localhost:1234/v1
CTXMTG_LLM__FARMING__MODEL=your-light-model-id

CTXMTG_LLM__FUSION__API_KEY=sk-dummy-key
CTXMTG_LLM__FUSION__BASE_URL=http://localhost:1234/v1
CTXMTG_LLM__FUSION__MODEL=your-light-model-id

# --- Heavier roles (recommended: larger local model) ------------------------

CTXMTG_LLM__RETRIEVAL__API_KEY=sk-dummy-key
CTXMTG_LLM__RETRIEVAL__BASE_URL=http://localhost:1234/v1
CTXMTG_LLM__RETRIEVAL__MODEL=your-heavy-model-id

CTXMTG_LLM__SYNTHESIS__API_KEY=sk-dummy-key
CTXMTG_LLM__SYNTHESIS__BASE_URL=http://localhost:1234/v1
CTXMTG_LLM__SYNTHESIS__MODEL=your-heavy-model-id
